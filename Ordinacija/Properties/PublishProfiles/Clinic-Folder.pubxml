<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain folder publish for the clinic (framework-dependent, same as the old FolderProfile1). Contains no secrets.
  UseDeploySettings=true makes the output contain appsettings.Deploy.json (untracked) as
  appsettings.Local.json, and runs the ValidateDeploySettings guard. See Deploy/DEPLOY.md.
-->
<Project>
  <PropertyGroup>
    <UseDeploySettings>true</UseDeploySettings>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>C:\OrdinacijaDeploy\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
